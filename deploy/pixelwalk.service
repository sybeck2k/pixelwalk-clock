[Unit]
Description=Pixelwalk LED display
After=multi-user.target

[Service]
# Edit the two paths below to match your install
ExecStart=/opt/pixelwalk/venv/bin/python -m pixelwalk --profile pi --config /etc/pixelwalk/config.toml
Environment=PYTHONPATH=/opt/pixelwalk/src
WorkingDirectory=/opt/pixelwalk
User=root
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
